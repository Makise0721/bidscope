# Production Compose configuration. Replace every blank value with the
# deployment-specific secret or endpoint before starting the stack.
BIDSCOPE_APP_MODE=production
BIDSCOPE_DATABASE_URL=
BIDSCOPE_CHECKPOINT_DATABASE_URL=
BIDSCOPE_POSTGRES_DB=
BIDSCOPE_POSTGRES_USER=
BIDSCOPE_POSTGRES_PASSWORD=
BIDSCOPE_REAL_MODEL_ENABLED=false
# Required only when BIDSCOPE_REAL_MODEL_ENABLED=true.
BIDSCOPE_MODEL_API_KEY=
BIDSCOPE_MODEL_BASE_URL=https://api.deepseek.com
BIDSCOPE_MODEL_NAME=deepseek-chat
BIDSCOPE_ADMIN_TOKEN=
BIDSCOPE_ADMIN_TOKEN_MIN_LENGTH=32
BIDSCOPE_ALLOWED_ORIGINS=["https://bidscope.example.test"]
BIDSCOPE_TRUSTED_HOSTS=["bidscope.example.test"]
BIDSCOPE_EXTERNAL_SCHEME=https
BIDSCOPE_OBJECT_STORE_TYPE=s3
BIDSCOPE_S3_ENDPOINT=
BIDSCOPE_S3_REGION=us-east-1
BIDSCOPE_S3_BUCKET=
BIDSCOPE_S3_ACCESS_KEY=
BIDSCOPE_S3_SECRET_KEY=
BIDSCOPE_S3_PREFIX=
# Backups are written by the explicit Compose ops profile. The host-side
# ./data/backups directory is mounted at this path inside the one-shot service.
BIDSCOPE_BACKUP_ROOT=/app/data/backups
BIDSCOPE_BACKUP_DAILY_RETENTION=7
BIDSCOPE_BACKUP_WEEKLY_RETENTION=4
BIDSCOPE_BACKUP_S3_ENABLED=false
# Leave the external backup target blank unless replication is enabled.
BIDSCOPE_BACKUP_S3_ENDPOINT=
BIDSCOPE_BACKUP_S3_REGION=us-east-1
BIDSCOPE_BACKUP_S3_BUCKET=
BIDSCOPE_BACKUP_S3_PREFIX=bidscope-backups
BIDSCOPE_BACKUP_S3_ACCESS_KEY=
BIDSCOPE_BACKUP_S3_SECRET_KEY=
