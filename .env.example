BIDSCOPE_APP_MODE=demo
# Live CCGP acquisition is disabled by default. Credentials belong only to
# the isolated ingestion process role and must come from an approved operator.
BIDSCOPE_PROCESS_ROLE=api
BIDSCOPE_LIVE_INGESTION_ENABLED=false
BIDSCOPE_CCGP_API_BASE_URL=
BIDSCOPE_CCGP_CLIENT_ID=
BIDSCOPE_CCGP_SIGNING_KEY=
BIDSCOPE_CCGP_AUTHORIZATION_REF=
BIDSCOPE_CCGP_POLL_SECONDS=900
BIDSCOPE_CCGP_REQUEST_TIMEOUT_SECONDS=20
BIDSCOPE_CCGP_MAX_RESPONSE_BYTES=10485760
BIDSCOPE_CCGP_MAX_PAGES_PER_RUN=100
BIDSCOPE_CCGP_MIN_INTERVAL_SECONDS=1
# Required only when live ingestion is explicitly enabled.
BIDSCOPE_CCGP_DATA_CONTRACT_VERSION=
BIDSCOPE_CCGP_DATA_OWNER=
BIDSCOPE_CCGP_DATA_REGIONS=[]
BIDSCOPE_CCGP_DATA_CATEGORIES=[]
BIDSCOPE_CCGP_DATA_REVIEW_STATUS=
BIDSCOPE_CCGP_DATA_REVIEWED_AT=
BIDSCOPE_CCGP_DATA_UPDATE_SLA=weekly
BIDSCOPE_CCGP_DATA_RETENTION_DAYS=
BIDSCOPE_DATABASE_URL=postgresql+asyncpg://bidscope:bidscope@localhost:5432/bidscope
BIDSCOPE_CHECKPOINT_DATABASE_URL=postgresql+psycopg://bidscope:bidscope@localhost:5432/bidscope
BIDSCOPE_REAL_MODEL_ENABLED=false
# Required only for `bidscope eval validate-real`: Base64-encoded Ed25519
# public key for detached snapshot-admission catalog signatures. Do not place
# the matching private key in this application or this file.
BIDSCOPE_REAL_EVALUATION_CATALOG_PUBLIC_KEY=
# Keep this empty for demo/development. Production requires a generated secret
# at least BIDSCOPE_ADMIN_TOKEN_MIN_LENGTH characters long.
BIDSCOPE_ADMIN_TOKEN=
BIDSCOPE_ADMIN_TOKEN_MIN_LENGTH=32
# JSON URL and host lists. Keep them empty for demo/development.
BIDSCOPE_ALLOWED_ORIGINS=[]
BIDSCOPE_TRUSTED_HOSTS=[]
BIDSCOPE_EXTERNAL_SCHEME=http

# Object storage. Defaults to the local filesystem; set to `s3` and supply the
# S3_* fields to target a MinIO or AWS S3 backend (see compose.yaml for an
# example pointing at a local MinIO).
BIDSCOPE_OBJECT_STORE_TYPE=local
BIDSCOPE_OBJECT_STORE_ROOT=data/objects
# BIDSCOPE_S3_ENDPOINT=http://minio:9000
# BIDSCOPE_S3_REGION=us-east-1
# BIDSCOPE_S3_BUCKET=bidscope
# BIDSCOPE_S3_ACCESS_KEY=
# BIDSCOPE_S3_SECRET_KEY=
# BIDSCOPE_S3_PREFIX=
